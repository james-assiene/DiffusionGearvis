.PHONY: bootstrap sync fast lint type check hud gpu pending ci plugin-wheel stt-image cd-test browser browser-live browser-demo browser-handoff browser-rtx browser-suite browser-threejs browser-web browser-web-network search-live
bootstrap:   ; bash scripts/bootstrap.sh
sync:        ; uv sync --all-extras
fast:        ; uv run pytest tests/unit tests/contract -q -m "not gpu"   # canonical serial run (the verifier quotes this; ceiling 120 s)
fast-parallel: ; uv run pytest tests/unit tests/contract -q -m "not gpu" -n 12 --dist loadfile   # what the Stop hook runs (budget 60 s, T-0031, T-0143)
lint:        ; uv run ruff check . && uv run ruff format --check .
type:        ; uv run mypy local_astra
pending:     ; uv run python scripts/check_pending.py
check: lint type fast pending
hud:         ; node --test tests/hud && uv run pytest tests/integration/test_hud_headless.py -q -m integration   # needs node + google-chrome; deliberately not in `check`
browser:     ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_computer_browser_e2e.py tests/integration/test_t0134_extent_browser.py tests/integration/test_t0140_overview_browser.py tests/integration/test_t0151_overview_frame_browser.py tests/integration/test_t0174_navigated_browser.py tests/integration/test_t0188_beforeunload_browser.py tests/integration/test_t0189_type_replaces_browser.py tests/integration/test_t0194_slow_focus_browser.py tests/integration/test_t0198_front_browser.py tests/integration/test_t0200_blank_recapture_browser.py tests/integration/test_t0202_wait_browser.py tests/integration/test_t0203_follow_driver_browser.py tests/integration/test_t0203_follow_browser.py tests/integration/test_t0204_driver_signals_browser.py tests/integration/test_t0204_preclick_browser.py tests/integration/test_t0204_settle_browser.py tests/integration/test_t0206_submit_browser.py tests/integration/test_t0210_body_focus_browser.py -q -m browser   # Playwright's Chromium on loopback fixtures (T-0111c); not in `check`
browser-live: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_computer_live_browser_e2e.py tests/integration/test_computer_live_session.py tests/integration/test_t0177_live_shared_browser.py tests/integration/test_t0187_late_popup_session.py -q -m browser   # tools = live: the start pages and a real Session over the fakes (T-0111g); T-0177 B: the shared screen through BrowserFrameSource; not in `check`
browser-suite: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_t0138_suite_browser.py -q -m browser   # the S6-S15 suite pages through the real executor (T-0138 A10); not in `check`
browser-web: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_computer_web_browser.py tests/integration/test_t0169_web_start_page_browser.py tests/integration/test_t0192_checkout_browser.py tests/integration/test_t0192_hand_back_browser.py -q -m browser   # web mode through the egress proxy, injected resolver/connector, loopback fixtures posing as *.example (T-0160 B-7); T-0169: a cli-built live session opens /web.html (--no-web: /); no network; not in `check`
browser-demo: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_t0205_scenarios_browser.py tests/integration/test_t0205_scenarios_session.py -q -m browser   # the D1-D9 demo scenario copies (pages/scenarios/, never served by astra session) in web mode on loopback (T-0205 A9); not in `check`
browser-handoff: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_t0208_share_handoff_hud.py tests/integration/test_t0208_handoff_session.py tests/integration/test_t0211_shared_ctrl_l.py -q -m browser   # shared screen -> browser handoff: a real Share click to the session (T-0208 A1) and the H1-H3 loopback handoff scenarios (T-0208 B); T-0211 B6: Ctrl+L from a shared step 1 reaches the browser; not in `check`
browser-rtx: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_t0209_rtx_browser.py tests/integration/test_t0209_rtx_session.py -q -m browser   # RTX 5090 audience scenarios on loopback (pages/rtx/, the loopback search index; T-0209 A1/A2); not in `check`
browser-threejs: ; ASTRA_BROWSER_TESTS=1 uv run pytest tests/integration/test_t0210_threejs_session.py -q -m browser   # the vendored three.js r179 editor (local_astra/pages/threejs/, never served by astra session): M1-M5 golden paths, traps, seeds, no egress (T-0210 B12); not in `check`
browser-web-network: ; ASTRA_BROWSER_TESTS=1 GEARVIS_WEB_NETWORK=1 uv run pytest tests/integration/test_computer_web_network.py -q -m browser   # web mode on the REAL network (example.com, localtest.me, metadata/decimal-IP refusals; T-0160 C-5); by hand only, never in `check`
search-live: ; ASTRA_LIVE_SEARCH=1 uv run pytest -q -m net tests/contract/test_ddgs_live.py tests/contract/test_search_backend_protocol.py tests/contract/test_brave_api_live.py   # the ddgs backend against DuckDuckGo (T-0111b), and the Brave Search API backend when its key file is configured (T-0163): needs the network, no GPU; not in `check`
cd-test:     ; ASTRA_CD_TESTS=1 uv run --all-extras --group cd pytest tests/cd -q -m "not gpu"
gpu:         ; uv run pytest -q -m gpu          # 5090 box only, via /launch
ci: check
plugin-wheel: ; cd plugin/astra_vllm_plugin && uv build --wheel   # installed inside the vLLM container by services/vllm.sh
stt-image:   ; docker build -t astra-moshi:0.6.4 -f services/moshi/Dockerfile services/moshi   # ~15 min; see the Dockerfile for why CUDA 12.8.1 is the only workable version
